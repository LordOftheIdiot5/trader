# Copy to .env and fill in. .env is gitignored; never commit the real one.
#
# ---------------------------------------------------------------------------
# HOW TO SCOPE THESE KEYS SO THEY CANNOT WITHDRAW
# ---------------------------------------------------------------------------
# This is the part that matters. The code has no withdraw method, but the
# keys are the lock that actually holds.
#
# Alpaca (stocks)
#   Paper and live use different keys and different base URLs. Alpaca API keys
#   cannot initiate ACH transfers at all - moving money to a bank is a separate
#   authenticated flow - so a trading key is already withdrawal-incapable.
#   Start on paper. The only difference is the base URL below.
#
# Crypto exchange (pick one; ccxt speaks to all of them)
#   Create an API key with TRADE enabled and WITHDRAW disabled, then bind it to
#   your VPS's static IP. Withdrawal is off by default everywhere and needs a
#   second confirmation to turn on - leave it off.
#     Kraken   : Query Funds + Create & Modify Orders. Do NOT tick Withdraw Funds.
#     Coinbase : scope "trade". Do NOT grant "transfer".
#     Binance  : Enable Spot Trading. Leave Enable Withdrawals unticked.
#   Worst case if one of these leaks: someone can trade your balance badly.
#   They cannot move it off the exchange.

# --- Alpaca -----------------------------------------------------------------
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Paper:  https://paper-api.alpaca.markets
# Live :  https://api.alpaca.markets      <- only change this when you mean it
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Crypto exchange --------------------------------------------------------
# Any ccxt exchange id: kraken, coinbase, binance, bitstamp, ...
EXCHANGE_ID=kraken
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Some venues (Coinbase, OKX) also need a passphrase. Leave blank otherwise.
EXCHANGE_PASSPHRASE=
